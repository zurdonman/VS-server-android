#!/usr/bin/env bash
# VS Code Server Android — comando corto: vs-server
# Instalado en el PATH por scripts/termux-setup.sh (funciona desde cualquier carpeta).
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

# La URL del cliente web lleva el id del build (asi el navegador descarga el
# bundle nuevo en vez de usar el que tiene en cache). Se muestra para saber
# que URL abrir.
if [[ -f "$ROOT/release/lib/vscode/product.json" ]]; then
  BUILD_COMMIT="$(sed -n 's/.*"commit"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$ROOT/release/lib/vscode/product.json" | head -n 1)"
  if [[ -n ${BUILD_COMMIT:-} ]]; then
    echo "Cliente: http://localhost:8080/stable-$BUILD_COMMIT/"
  fi
fi

exec bash "$ROOT/scripts/termux-start.sh" "$@"
