 		}
 
-		return serveFile(filePath, this._environmentService.isBuilt ? CacheControl.NO_EXPIRY : CacheControl.ETAG, this._logService, req, res, headers);
+		// Android/Termux (code-server): con NO_EXPIRY el servidor responde
+		// "Cache-Control: public, max-age=31536000", asi que el navegador se
+		// guarda el bundle del workbench durante un ano. Como la URL del
+		// bundle no cambia entre compilaciones, al actualizar el servidor el
+		// movil se queda con el bundle viejo (no se ven los cambios).
+		// Con ETAG el navegador revalida en cada carga y solo vuelve a
+		// descargar el fichero si ha cambiado.
+		return serveFile(filePath, CacheControl.ETAG, this._logService, req, res, headers);
 	}
 
