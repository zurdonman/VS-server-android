+//#region Configuration
+
+const configurationRegistry = Registry.as<IConfigurationRegistry>(ConfigExtensions.Configuration);
+const keyboardConfiguration: IConfigurationNode = {
+	'id': 'mobileKeyboard',
+	'order': 20,
+	'type': 'object',
