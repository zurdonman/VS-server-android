@@ -26,6 +26,14 @@ export function readKeyboardConfig(configurationService: IConfigurationService):
 	return { dispatch, mapAltGrToCtrlAlt };
 }
 
+// Mobile browsers with virtual keyboards (Android soft keyboards in particular)
+// routinely leave `KeyboardEvent.code` empty or wrong, which breaks keybindings
+// and the tab key when dispatching by `code`. Default to `keyCode` dispatch on
+// those platforms; users can still opt back in with `"keyboard.dispatch": "code"`.
+const isMobileVirtualKeyboard = typeof navigator !== 'undefined'
+	&& (navigator.maxTouchPoints ?? 0) > 0
+	&& /Android|iPhone|iPad|Mobile/i.test(navigator.userAgent || '');
+
 const configurationRegistry = Registry.as<IConfigurationRegistry>(ConfigExtensions.Configuration);
