+				// context as a textupdate. Cancel the DOM edit so a textupdate (or the
+				// edit context's own bookkeeping) cannot insert a second line break.
+				e.preventDefault();
 				this._onType(this._viewController, { text: '\n', replacePrevCharCnt: 0, replaceNextCharCnt: 0, positionDelta: 0 });
