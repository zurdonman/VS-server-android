+/**
+ * Mobile/CI-friendly merge: runs the given stream factories with at most
+ * `limit` in flight (es.merge starts them all at once, which can exhaust RAM
+ * when each factory spawns an esbuild process).
+ */
+function mergeWithLimit(streamFactories: (() => Stream)[], limit: number): Stream {
+	const out = new PassThrough({ objectMode: true }) as unknown as Stream & { write(c: unknown): boolean; end(): void; destroy(e: Error): void };
+	let index = 0;
+	let active = 0;
+	let done = false;
+	const pump = () => {
+		while (!done && active < limit && index < streamFactories.length) {
+			const src = streamFactories[index++]();
+			active++;
+			src.on('data', (chunk: unknown) => {
+				if (!(out as unknown as { write(c: unknown): boolean }).write(chunk)) {
+					src.pause();
+					(out as unknown as { once(e: string, cb: () => void): void }).once('drain', () => src.resume());
+				}
+			});
+			src.on('end', () => {
+				active--;
+				if (active === 0 && index >= streamFactories.length) {
+					done = true;
+					out.end();
+				} else {
+					pump();
+				}
+			});
+			src.on('error', (err: Error) => { done = true; out.destroy(err); });
+		}
+	};
+	if (streamFactories.length === 0) {
+		out.end();
+	} else {
+		pump();
+	}
+	return out as unknown as Stream;
+}
