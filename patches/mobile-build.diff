+// VS Code Server Android: web-only variant of core-ci. Builds just the
+// server-web bundle (plus codicons and the extension build outputs the reh-web
+// packaging step needs) so it can run on memory-constrained devices where the
+// desktop and node server bundles would OOM. Pair with
+// `vscode-reh-web-<platform>-min-ci` to package.
+task.task(task.define('core-ci-web', task.series(
+	copyCodiconsTask,
+	compileNonNativeExtensionsBuildTask,
+	compileExtensionMediaBuildTask,
+	compileCopilotExtensionFullBuildTask,
+	task.define('esbuild-vscode-reh-web-min-web', () => runEsbuildBundle('out-vscode-reh-web-min', true, true, 'server-web', `${sourceMappingURLBase}/core`)),
+)));
